{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-control-lab",
  "account_id": "9fa6b3dd10d11d3dee396ec7e58e49f7",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-control-lab",
      "database_id": "e2802169-3e21-4619-98c7-2c016a649539",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "APP_VERSION": "1.0.0" },
}
